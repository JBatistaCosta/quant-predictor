# Config do Elastic Beanstalk (plataforma Node.js).
# NPM_USE_PRODUCTION=false: sem isso, o EB roda "npm install --production" e
# pula devDependencies — quebraria o build do front-end (vite, tailwind etc.
# estão em devDependencies), que roda no hook .platform/hooks/predeploy/.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NPM_USE_PRODUCTION: false
    NODE_ENV: production
