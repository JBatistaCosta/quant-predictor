# Usado por "npm run build:aws" (vite --mode aws).
# Na AWS (Elastic Beanstalk), front-end e API rodam no MESMO processo e no
# MESMO domínio (ver server/app.js) — por isso rotas relativas bastam, sem
# precisar de VITE_API_BASE_URL apontando pra fora (diferente do Firebase).
VITE_API_BASE_URL=

# Conexão com o banco do Supabase para o front-end (mesma chave pública
# "publishable" já usada em .env.firebase — não é segredo, pode ficar no Git)
VITE_SUPABASE_URL=https://cgurxgfdmpmsnrshqycx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_pOX8y7CjfFALS_dCZ61w7g_wEPu7T4g
