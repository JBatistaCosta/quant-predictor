{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/sync-matches",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/model-maintenance?tarefa=elo-rotativo",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/model-maintenance?tarefa=player-elo&limite=500",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/model-maintenance?tarefa=paper-carteira-rodar-todas",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/model-maintenance?tarefa=recalcular-model-stats&mercado=corners_over_under_9.5",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/model-maintenance?tarefa=recalcular-model-stats&mercado=over_under_2.5",
      "schedule": "10 10 * * *"
    },
    {
      "path": "/api/model-maintenance?tarefa=recalcular-model-stats&mercado=1X2",
      "schedule": "20 10 * * *"
    }
  ],
  "functions": {
    "api/model-maintenance.js": { "maxDuration": 60 },
    "api/backtest-betting.js": { "maxDuration": 30 },
    "api/sync-match-stats.js": { "maxDuration": 60 },
    "api/model-stats.js": { "maxDuration": 60 }
  }
}
