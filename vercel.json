{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/sync-matches",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/model-maintenance?tarefa=odds-todas",
      "schedule": "0 16 */3 * *"
    },
    {
      "path": "/api/model-maintenance?tarefa=elo-rotativo",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/model-maintenance?tarefa=paper-carteira-rodar-todas",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/model-maintenance.js": { "maxDuration": 60 },
    "api/backtest-betting.js": { "maxDuration": 30 },
    "api/sync-match-stats.js": { "maxDuration": 60 },
    "api/model-stats.js": { "maxDuration": 30 }
  }
}
